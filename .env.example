PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:5173
DATABASE_URL="postgresql://intrnd:intrnd_local_password@localhost:54329/intrnd"
JWT_SECRET=replace-this-with-a-long-random-secret
NODE_ENV=development
PILOT_CATALOG_MODE=CANDIDATES
PILOT_MINIMUM_READY_PROJECTS=24
SCRAPER_ENABLED=false

# Google OAuth web client ID.
# Add http://127.0.0.1:5173 and your production domain as authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Local AI (Ollama) configuration for Intrnd AI features.
# Install Ollama from https://ollama.com/download then run:
#   ollama pull deepseek-r1:7b
#   ollama serve
#
# Ollama exposes an OpenAI-compatible API at http://localhost:11434/v1
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=deepseek-r1:7b
AI_REASONER_MODEL=deepseek-r1:7b
# Set to "false" to disable AI endpoints entirely.
AI_ENABLED=false
VITE_EXPERIMENTAL_AI_ENABLED=false

# Private submission evidence storage. Local development writes to .local/.
SUBMISSION_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
CLAMAV_HOST=
CLAMAV_PORT=3310
