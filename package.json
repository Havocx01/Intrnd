{
  "name": "intrnd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:full": "concurrently --kill-others-on-fail --names client,api \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build:server": "tsc -p server/tsconfig.json",
    "build:full": "npm run typecheck && npm run build && npm run build:server",
    "start": "node dist-server/index.js",
    "db:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:projects:v3": "tsx server/src/catalog/importV3Projects.ts",
    "qa:reset": "tsx server/src/qa/resetLocalQa.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:submissions": "tsx server/src/submissions/submissions.test.ts",
    "test:ranking-service": "tsx server/src/ranking/rankingService.test.ts",
    "benchmark:predictions": "tsx server/src/ranking/exportBenchmarkPredictions.ts",
    "test:profile-features": "tsx server/src/personalization/profileFeatureService.test.ts",
    "test:project-presentation": "tsx server/src/projects/projectPresentation.test.ts",
    "test:catalog-provenance": "tsx server/src/catalog/v3ProjectCatalog.test.ts",
    "test:application-status-ui": "tsx src/lib/applicationStatus.test.ts",
    "test:ranking-response": "tsx src/lib/rankingResponse.test.ts",
    "test:lifecycle": "tsx server/src/projects/applicationLifecycle.test.ts",
    "test:privacy": "tsx server/src/telemetry/productEvents.test.ts",
    "test:cohort-metrics": "tsx server/src/telemetry/cohortMetrics.test.ts",
    "test:authorization": "tsx server/src/auth/roles.test.ts",
    "test:roadmaps": "tsx server/src/roadmaps/roadmapService.test.ts",
    "test:pilot-catalog": "tsx server/src/pilotCatalog/pilotCatalog.test.ts",
    "test": "npm run test:submissions && npm run test:profile-features && npm run test:project-presentation && npm run test:ranking-service && npm run test:catalog-provenance && npm run test:application-status-ui && npm run test:ranking-response && npm run test:lifecycle && npm run test:privacy && npm run test:cohort-metrics && npm run test:authorization && npm run test:roadmaps && npm run test:pilot-catalog",
    "backfill:submission-requirements": "tsx server/src/submissions/backfillSubmissionRequirements.ts",
    "roadmaps:sync": "tsx server/src/roadmaps/syncCatalog.ts --force",
    "roadmaps:catalog:generate": "tsx server/src/roadmaps/generateCatalogArtifact.ts",
    "pilot-catalog:sync": "tsx server/src/pilotCatalog/sync.ts",
    "career-mappings:sync": "tsx server/src/career/syncPilotMappings.ts",
    "qa:pilot-readiness": "tsx server/src/qa/pilotReadiness.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.1.8",
    "@astryxdesign/theme-neutral": "^0.1.8",
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@prisma/client": "^6.17.1",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.4.1",
    "file-type": "^22.0.1",
    "framer-motion": "^12.38.0",
    "google-auth-library": "^10.6.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.545.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "openai": "^6.36.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.7.2",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "prisma": "^6.17.1",
    "tsx": "^4.20.6"
  }
}
